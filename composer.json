{
  "name": "tinywan/webman-typephp",
  "description": "TypePHP AOT native binary compiler and packager plugin for Webman",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Tinywan",
      "email": "756684177@qq.com"
    }
  ],
  "require": {
    "php": ">=8.4 <8.6",
    "symfony/process": "^7.0 || ^8.0",
    "workerman/webman-framework": "^1.5.4||^2.0||dev-master",
    "webman/console": "^1.0||^2.0"
  },
  "autoload": {
    "psr-4": {
      "Tinywan\\Typephp\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require-dev": {
    "carthage-software/mago": "^1.5",
    "pestphp/pest": "^4.0"
  },
  "scripts": {
    "format:check": "mago format --check",
    "format": "mago format",
    "lint": "mago lint",
    "analyze": "mago analyze",
    "test": "pest",
    "check": [
      "@format:check",
      "@lint",
      "@analyze",
      "@test"
    ],
    "post-package-install": [
      "Tinywan\\Typephp\\Install::install"
    ],
    "post-package-update": [
      "Tinywan\\Typephp\\Install::install"
    ],
    "pre-package-uninstall": [
      "Tinywan\\Typephp\\Install::uninstall"
    ]
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "carthage-software/mago": true
    },
    "sort-packages": true
  }
}
